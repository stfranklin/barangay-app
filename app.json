{
  "expo": {
    "name": "barangay-app",
    "slug": "barangay-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/barangay-official-seal.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/barangay-official-seal.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/barangay-official-seal.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/barangay-official-seal.png"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
